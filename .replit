modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "study-sync"

[[workflows.workflow]]
name = "study-sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:study"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_NErke8yiZihOyI"
WHOP_PLAN_ID = "plan_xzffNBWv01GQN"
WHOP_PRODUCT_ID = "prod_2AjYfdpDCPKOB"
APP_PUBLIC_URL = "https://yael-hebrew-prep.replit.app"

[userenv.development]
WHOP_CHECKOUT_ENABLED = "true"
