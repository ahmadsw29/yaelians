{
  "expo": {
    "name": "Yaelians",
    "slug": "yael-arabic-prep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/yaelians-icon.png",
    "scheme": "yael-arabic-prep",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/yaelians-icon.png"
    },
    "plugins": [
      ["expo-splash-screen", {
        "image": "./assets/images/yaelians-mark.png",
        "imageWidth": 180,
        "resizeMode": "contain",
        "backgroundColor": "#f7f4ed"
      }],
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
